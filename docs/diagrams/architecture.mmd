flowchart TD
    subgraph CLI["cmd/perch — CLI entry-point"]
        main["main.go\ndispatch"]
    end

    subgraph GUILayer["GUI layer"]
        apppkg["app/\nWails App + bound methods\ninput validation + event forwarding"]
        pty["internal/pty\ndirect pty Bridge\n(creack/pty + login shell)\nxterm.js events — no tmux"]
        frontend["frontend/\nSvelte 5 SPA\nWails bindings + events"]
    end

    subgraph Agents["Agent Monitor seam — internal/agent"]
        monitor["Monitor seam\nPrepare / Start / Events\nApprove / Caps / Teardown"]
        claudemon["ClaudeMonitor"]
        opencodemon["OpencodeMonitor"]
        hooklistener["internal/hooklistener\n127.0.0.1:ephemeral\nrandom Bearer token\nPreToolUse blocks"]
    end

    subgraph CLIFlows["CLI sub-commands"]
        setup["perch setup\ninstall agent hooks/plugins"]
        attach["perch attach &lt;query&gt;\nregistry lookup (no tmux)"]
        doctor["internal/doctor\nperch doctor"]
    end

    subgraph DataLayer["Data & config"]
        registry["internal/registry\nworkspaces.json (XDG)\n~/.config/perch/"]
        config["internal/config\nglobal config.toml\n+ project .perch.toml"]
        model["internal/model\nshared domain types"]
    end

    subgraph Discovery["Discovery"]
        discover["internal/discover\ngit repo scanner"]
    end

    subgraph Worktrees["Worktrees"]
        worktree["internal/worktree\nfile seed + lifecycle hooks"]
        fs["internal/fs\nfile tree + change watcher"]
    end

    subgraph ShellSeam["Shell-out seam (§20.1)"]
        proc["internal/proc\nRunner interface\nFakeRunner in tests"]
        git["internal/git\ngit command wrappers + diff/hunks"]
    end

    subgraph External["External"]
        shell[("login shell\n(direct pty, per pane)")]
        claudeagent["claude agent\n(hooks POST events)"]
        opencodeagent["opencode serve\n(SSE /event stream)"]
    end

    main -->|"launch GUI"| apppkg
    main -->|"sub-cmd"| setup
    main -->|"sub-cmd"| attach
    main -->|"sub-cmd"| doctor

    frontend <-->|"Wails bindings + events\n(no TCP port)"| apppkg
    apppkg -->|"App → Bridge → Shell"| pty
    apppkg -->|"new Monitor"| monitor
    apppkg -->|"read/write"| registry
    apppkg -->|"load config"| config
    apppkg -->|"worktree create/remove"| worktree
    apppkg -->|"file tree / watch"| fs
    apppkg -->|"project scan"| discover
    apppkg -->|"diff / staging"| git

    pty -->|"exec"| shell

    monitor --> claudemon
    monitor --> opencodemon
    claudemon -->|"App → ClaudeMonitor → hooklistener"| hooklistener
    hooklistener <-->|"PreToolUse blocks; Decide()"| claudeagent
    opencodemon -->|"App → OpencodeMonitor → serve/SSE"| opencodeagent

    attach -->|"read"| registry

    worktree -->|"hooks via"| proc
    git -->|"uses"| proc
    monitor -->|"uses"| model
