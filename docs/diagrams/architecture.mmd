flowchart TD
    subgraph CLI["cmd/perch — CLI entry-point"]
        main["main.go\ndispatch"]
    end

    subgraph GUILayer["GUI layer"]
        apppkg["app/\nWails App + bound methods\ninput validation + state-sync poller"]
        pty["internal/pty\nattach-pty bridge\n(creack/pty + xterm.js events)"]
        frontend["frontend/\nSvelte 5 SPA\nWails events + bound methods"]
    end

    subgraph CLIFlows["CLI sub-commands"]
        attach["internal/attach\nperch attach &lt;query&gt;"]
        resurrect["internal/resurrect\nKEEP / PRUNE / RESTORE\nreconciler"]
        status["internal/status\nperch status set\n@perch_pane_status writer"]
        doctor["internal/doctor\nperch doctor\nhealth check"]
    end

    subgraph DataLayer["Data &amp; config"]
        state["internal/state\nstate.json (mappings + frecency)\nwindows/&lt;k&gt;.json (per-window)"]
        config["internal/config\nglobal config.toml\n+ project .perch.toml"]
        trust["internal/trust\nTOFU trust store\ntrust.json (mode 0600)"]
        model["internal/model\nshared domain types\nWindow, Session, Tool…"]
    end

    subgraph Discovery["Discovery"]
        discover["internal/discover\ngit repo scanner"]
    end

    subgraph Agents["Agent adapters"]
        agent["internal/agent\nAdapter interface\nclaude / opencode"]
        worktree["internal/worktree\nfile seed + lifecycle\nhooks (post_create, pre_remove…)"]
    end

    subgraph ShellSeam["Shell-out seam (§20.1)"]
        proc["internal/proc\nRunner interface\nFakeRunner in tests"]
        tmuxpkg["internal/tmux\ntmux command wrappers"]
        git["internal/git\ngit command wrappers"]
    end

    subgraph External["External — tmux server"]
        tmuxsrv[("tmux server\n(default socket)")]
        agentsess["agent sessions\n(detached, one per agent)"]
    end

    main -->|"launch GUI"| apppkg
    main -->|"sub-cmds"| attach
    main -->|"sub-cmds"| resurrect
    main -->|"sub-cmds"| status
    main -->|"sub-cmds"| doctor

    frontend <-->|"Wails events + bound methods\n(WebKit2GTK IPC, no TCP port)"| apppkg
    apppkg -->|"open terminal tab"| pty
    apppkg -->|"read/write"| state
    apppkg -->|"load config"| config
    apppkg -->|"agent argv"| agent
    apppkg -->|"worktree create/remove"| worktree
    apppkg -->|"project scan"| discover
    apppkg -->|"orchestration"| tmuxpkg

    pty -->|"tmux attach via"| tmuxpkg

    attach -->|"read"| state
    resurrect -->|"read/write"| state
    resurrect -->|"shell-out"| tmuxpkg
    status -->|"shell-out"| tmuxpkg

    agent -->|"uses"| model
    worktree -->|"hooks via"| proc
    git -->|"uses"| proc
    tmuxpkg -->|"uses"| proc

    proc -->|"exec"| tmuxsrv
    tmuxsrv --- agentsess
