flowchart TD
    subgraph Create["CREATE path"]
        w_start(["user creates a session\n(GUI New Session dialog)"])
        w_pick["pick repo / branch / agent / model\n(repos discovered across configured roots)"]
        w_validate["validate:\nrepoPath under a configured root,\nbranch via git.ValidRef,\nagent known (claude / opencode)"]
        w_derive["derive linked-worktree path\n(repo + slugified branch),\nre-check it stays under roots"]
        w_git_add["git worktree add\n(an existing branch is tolerated)"]
        w_state["record workspace\nin workspaces.json"]
        w_launch["open workspace:\nspawn direct pty + login shell,\nstart agent Monitor"]

        w_start --> w_pick
        w_pick --> w_validate
        w_validate --> w_derive
        w_derive --> w_git_add
        w_git_add --> w_state
        w_state --> w_launch
    end

    subgraph Remove["REMOVE path"]
        d_start(["user removes a session\n(GUI remove action)"])
        d_confirm["confirm modal,\nthen deferred removal\nwith an undo window"]
        d_undo{"undo before\nthe window closes?"}
        d_cancel["cancel: session restored,\nnothing torn down"]
        d_teardown["tear down pty Bridge + Monitor\n(Monitor.Teardown removes hook entries,\ncloses hooklistener)"]
        d_state2["remove workspace record\nfrom workspaces.json"]
        d_disk["worktree directory left on disk\n(removal is undoable; agent history persists)"]

        d_start --> d_confirm
        d_confirm --> d_undo
        d_undo -->|"yes"| d_cancel
        d_undo -->|"no — window elapsed"| d_teardown
        d_teardown --> d_state2
        d_state2 --> d_disk
    end
