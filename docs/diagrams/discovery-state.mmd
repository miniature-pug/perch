flowchart TD
    subgraph Config["global config.toml"]
        roots["roots []string\n(scan root directories)"]
        sort_order["sort_order []string"]
    end

    subgraph DiscoveryPipeline["Discovery pipeline — internal/discover"]
        scan["Scan each root\n(WalkDir, depth ≤ 8)\nfind dirs with .git entry"]
        dedup["deduplicate by\nmain worktree path"]
        worktrees["git worktree list\nper candidate repo\n(internal/git)"]
        frecency_sort["sort by FrecencyScore\n(zoxide algorithm)\ncold start → alphabetical"]
        candidates["ProjectTrees slice\n(Project + Trees[])"]
    end

    subgraph StateStores["State — $XDG_STATE_HOME/perch/"]
        statejson["state.json\nmappings: sessionID → {tool, tree, choice}\nprojects: path → {rank, last_accessed}"]
        windowsdir["windows/&lt;paneKey&gt;.json\none file per live tmux window\nconcurrent-safe (atomic write)"]
    end

    subgraph WindowRecord["Window record fields"]
        bootid["BootID\n(tmux server start_time)"]
        sessid["SessionID\n(@perch_session stamp)"]
        treetool["Tree, TmuxSession,\nTmuxWindow, Tool,\nUpdated"]
    end

    subgraph Resurrect["Resurrect — classify()"]
        keep["KEEP\npane live + boot matches"]
        prune["PRUNE\npane gone, same boot,\nhome session alive\n(intentional close)"]
        restore["RESTORE\nboot mismatch or cold server\n→ re-launch agent"]
    end

    roots --> scan
    scan --> dedup
    dedup --> worktrees
    worktrees --> frecency_sort
    statejson -->|"ProjectStat rank + last_accessed"| frecency_sort
    frecency_sort --> candidates
    candidates -->|"feeds TUI list"| tui_list["TUI session list"]

    windowsdir --> bootid
    windowsdir --> sessid
    windowsdir --> treetool

    bootid -->|"currentBoot == w.BootID?"| Resurrect
    sessid -->|"pane live?"| Resurrect

    keep -->|"no action"| done_k["record kept as-is"]
    prune -->|"remove record"| done_p["window pruned"]
    restore -->|"re-launch +\nupdate record"| done_r["agent restored"]
