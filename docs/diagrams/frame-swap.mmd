flowchart TD
    subgraph FrameSession["perch tmux session (the frame)"]
        sidebar["Sidebar pane\n@perch_frame=1\nperch --sidebar (TUI)"]
        mainslot["Main pane slot\n(visible to user)"]
    end

    subgraph AgentSessionA["Agent session A (detached)"]
        paneA["Agent pane A\n@perch_session=sid_A"]
    end

    subgraph AgentSessionB["Agent session B (detached)"]
        paneB["Agent pane B\n@perch_session=sid_B"]
    end

    placeholder["Placeholder pane\nsleep infinity\nexists for frame lifetime"]

    mainslot -.->|"initially holds"| placeholder

    sidebar -->|"select A + enter: swapInCmd\npaneA swaps with placeholder"| paneA
    paneA -.->|"now in frame main slot"| mainslot

    sidebar -->|"select B + enter: two swaps\n1-paneA back home 2-paneB in"| paneB
    paneB -.->|"now in frame main slot"| mainslot

    placeholder -.->|"parks in agent home session\nduring swap-in"| AgentSessionA

    sidebar -->|"q: quit\n1-swap displayed pane home\n2-KillSession frame"| survive["agent sessions\nsurvive in own sessions"]
