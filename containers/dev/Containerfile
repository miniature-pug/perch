# perch-dev: the one pinned dev/test environment.
#
# Toolchain only; no application source is baked. The repo is bind-mounted live
# at run time (containers/run.sh), so editing code never invalidates a layer.
# Every version arrives as a build-arg sourced from its single authoritative
# home (.tool-versions / the lockfile / the Makefile) — nothing is hardcoded
# here. Build it via `make image`, never `podman build` by hand, or the ARGs go
# unset.
FROM ubuntu:24.04

ARG GO_VERSION
ARG NODE_VERSION
ARG GOLANGCI_VERSION
ARG GOVULN_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# System + GUI/build libs. The GTK3 + WebKit2GTK-4.1 + xvfb set lets this one
# image cover `gui-build` (cgo) and the future headless GUI smoke. Noble ships
# only the -4.1 dev package (4.0 was dropped), which is why production builds
# carry `-tags webkit2_41`; libwebkit2gtk-4.1-dev pulls
# libsoup-3.0-dev transitively.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils \
      build-essential pkg-config \
      libgtk-3-dev libwebkit2gtk-4.1-dev \
      xvfb \
 && rm -rf /var/lib/apt/lists/*

# Go — official tarball, pinned by .tool-versions.
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
      | tar -C /usr/local -xz
ENV GOPATH=/root/go
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH

# Node — official tarball, pinned by .tool-versions.
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -C /usr/local --strip-components=1 -xJ

# Pinned go-tools baked in so lint/vulncheck run an offline prebaked binary on
# PATH (not `go run …@version` per invocation). GOFLAGS unset here so install can
# reach the network; the runtime GOFLAGS=-mod=vendor is set below.
RUN GOFLAGS= go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_VERSION}" \
 && GOFLAGS= go install "golang.org/x/vuln/cmd/govulncheck@${GOVULN_VERSION}"

# Playwright browsers + their system libs, version-matched to the lockfile. The
# temp npm ci exists only to drive `playwright install`; the browsers land baked
# in /root/.cache/ms-playwright (so e2e never re-downloads at run time) and the
# temp node_modules is thrown away (runtime re-installs into a masked volume).
COPY frontend/package.json frontend/package-lock.json /tmp/pw/
RUN apt-get update && cd /tmp/pw && npm ci \
 && npx --yes playwright install --with-deps chromium \
 && cd / && rm -rf /tmp/pw /var/lib/apt/lists/*

# Match the Makefile ethos for every run-time invocation: vendored, hermetic.
ENV GOFLAGS=-mod=vendor
WORKDIR /work
