# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Deferred worktree-teardown trash dirs (§7.2; transient, rm'd by the cleanup
# script — ignored in case a run or test is interrupted mid-teardown)
.perch_trash_*/

# Build output
/bin/
# Root binary from an ad-hoc `go build ./cmd/perch` (canonical build goes to /bin via `make build`)
/perch

# Editor/IDE
# .idea/
# .vscode/

frontend/node_modules/
frontend/dist/
frontend/wailsjs/
build/bin/
frontend/package.json.md5

# brainstorm visual companion
.superpowers/
